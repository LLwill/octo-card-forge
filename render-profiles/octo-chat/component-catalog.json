      "sections": [
        {
          "id": "foundation-typography",
          "title": "Typography scale",
          "description": "基础字号和字重，用于判断正文、辅助信息和标题的默认层级。",
          "rows": [
            {
              "name": "Small",
              "value": "TextBlock.size",
              "description": "辅助信息、时间、来源",
              "preview": "text"
            },
            {
              "name": "Default",
              "value": "TextBlock.size",
              "description": "正文和普通说明",
              "preview": "text"
            },
            {
              "name": "Medium",
              "value": "TextBlock.size",
              "description": "小标题和关键字段",
              "preview": "text"
            },
            {
              "name": "Large",
              "value": "TextBlock.size",
              "description": "卡片标题",
              "preview": "text"
            },
            {
              "name": "Bolder",
              "value": "TextBlock.weight",
              "description": "标题、状态、关键值",
              "preview": "text"
            }
          ]
        },
        {
          "id": "foundation-colors",
          "title": "Semantic colors",
          "description": "语义色只表达状态，不表达业务；业务状态应映射到这些固定语义。",
