{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:octo-card:schema:catalog-snapshot:1",
  "title": "Octo Card Catalog Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "mediaType", "channel", "revision", "cards"],
  "properties": {
    "formatVersion": { "const": 1 },
    "mediaType": { "const": "application/vnd.octo.card-catalog-snapshot+json;version=1" },
    "channel": { "enum": ["release", "preview"] },
    "revision": { "type": "string", "minLength": 1 },
    "cards": { "type": "array" }
  }
}
