{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:octo-card:schema:card-artifact:1",
  "title": "Octo Card Artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "mediaType", "card", "profile", "dataContract", "views", "validation"],
  "properties": {
    "formatVersion": { "const": 1 },
    "mediaType": { "const": "application/vnd.octo.card-artifact+json;version=1" },
    "card": { "$ref": "#/$defs/card" },
    "profile": { "$ref": "#/$defs/profile" },
    "dataContract": { "type": "object" },
    "views": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/view" }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "issues"],
      "properties": {
        "valid": { "const": true },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/validationIssue" } }
      }
    }
  },
  "$defs": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "contractVersion", "adaptiveCardVersion", "defaultLocale"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
        "contractVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
        "adaptiveCardVersion": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
        "defaultLocale": { "type": "string", "minLength": 1 }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "manifest", "capabilities"],
      "properties": {
        "reference": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*@\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
        "manifest": { "$ref": "#/$defs/profileManifest" },
        "capabilities": { "$ref": "#/$defs/capabilities" }
      }
    },
    "profileManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "version", "adaptiveCardsSdkVersion", "hostConfig", "stylesheet", "capabilities"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
        "compatibility": { "type": "string", "minLength": 1 },
        "packageName": { "type": "string", "minLength": 1 },
        "adaptiveCardsSdkVersion": { "type": "string", "minLength": 1 },
        "hostConfig": { "$ref": "#/$defs/packagePath" },
        "theme": { "$ref": "#/$defs/packagePath" },
        "stylesheet": { "$ref": "#/$defs/packagePath" },
        "tokens": { "$ref": "#/$defs/packagePath" },
        "capabilities": { "$ref": "#/$defs/packagePath" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "maxAdaptiveCardVersion", "allowedElements", "allowedActions", "maxNodes", "maxDepth", "maxPayloadBytes", "imageUrlSchemes", "openUrlSchemes"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "maxAdaptiveCardVersion": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
        "allowedElements": { "$ref": "#/$defs/stringArray" },
        "allowedActions": { "$ref": "#/$defs/stringArray" },
        "components": { "type": "object", "additionalProperties": { "$ref": "#/$defs/component" } },
        "utilities": { "type": "object", "additionalProperties": { "$ref": "#/$defs/utility" } },
        "utilityRules": { "type": "object", "additionalProperties": false, "properties": { "maxTokensPerElement": { "type": "integer", "minimum": 1 } } },
        "maxNodes": { "type": "integer", "minimum": 1 },
        "maxDepth": { "type": "integer", "minimum": 1 },
        "maxPayloadBytes": { "type": "integer", "minimum": 1 },
        "imageUrlSchemes": { "$ref": "#/$defs/stringArray" },
        "openUrlSchemes": { "$ref": "#/$defs/stringArray" }
      }
    },
    "stringArray": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "packagePath": { "type": "string", "pattern": "^(?![\\\\/])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\]+$" },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appliesTo", "variants"],
      "properties": {
        "appliesTo": { "$ref": "#/$defs/stringArray", "minItems": 1 },
        "variants": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/componentVariant" } }
      }
    },
    "componentVariant": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "fallback": { "type": "object" }, "deprecated": { "type": "boolean" } }
    },
    "utility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "appliesTo", "description"],
      "properties": {
        "group": { "type": "string", "minLength": 1 },
        "appliesTo": { "$ref": "#/$defs/stringArray", "minItems": 1 },
        "fallback": { "type": "object" },
        "description": { "type": "string", "minLength": 1 },
        "useWhen": { "$ref": "#/$defs/stringArray" },
        "avoidWhen": { "$ref": "#/$defs/stringArray" },
        "cssRequired": { "type": "boolean" },
        "deprecated": { "type": "boolean" }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wireProfile", "template", "samples"],
      "properties": {
        "wireProfile": { "enum": ["octo/v1", "octo/v2"] },
        "states": { "$ref": "#/$defs/stringArray", "minItems": 1, "uniqueItems": true },
        "submit_actions": { "$ref": "#/$defs/stringArray", "uniqueItems": true },
        "template": { "type": "object" },
        "samples": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sample" } }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "data", "card", "inspection"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "data": { "type": "object" },
        "card": { "type": "object" },
        "inspection": { "$ref": "#/$defs/inspection" }
      }
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions", "inputs", "toggles"],
      "properties": {
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/input" } },
        "toggles": { "type": "array", "items": { "$ref": "#/$defs/toggle" } }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "associatedInputs": { "enum": ["auto", "none"] },
        "inputIds": { "$ref": "#/$defs/stringArray" },
        "dataKeys": { "$ref": "#/$defs/stringArray" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "id", "type", "isRequired", "isVisible"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "isRequired": { "type": "boolean" },
        "isVisible": { "type": "boolean" },
        "maxLength": { "type": "integer", "minimum": 0 },
        "isMultiSelect": { "type": "boolean" },
        "choiceValues": { "$ref": "#/$defs/stringArray" }
      }
    },
    "toggle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "targets"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "targets": { "type": "array", "items": { "$ref": "#/$defs/toggleTarget" } }
      }
    },
    "toggleTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elementId"],
      "properties": { "elementId": { "type": "string", "minLength": 1 }, "isVisible": { "type": "boolean" } }
    },
    "validationIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "message"],
      "properties": {
        "severity": { "enum": ["error", "warning"] },
        "code": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "details": { "type": "object" }
      }
    }
  }
}
