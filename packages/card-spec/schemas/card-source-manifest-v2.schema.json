{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:octo-card:schema:card-source-manifest:2",
  "title": "Octo Card Source Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "contractVersion", "adaptiveCardVersion", "defaultLocale", "views", "dataSchema"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "contractVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "adaptiveCardVersion": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "renderProfile": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*@(latest|\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?)$" },
    "renderProfileCompatibility": { "type": "string", "minLength": 1 },
    "defaultLocale": { "type": "string", "minLength": 1 },
    "dataSchema": { "type": "string", "pattern": "^(?![\\\\/])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\]+$" },
    "views": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["wireProfile", "template", "samples"],
        "properties": {
          "wireProfile": { "enum": ["octo/v1", "octo/v2"] },
          "template": { "type": "string", "pattern": "^(?![\\\\/])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\]+$" },
          "samples": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(?![\\\\/])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\]+$" } },
          "states": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "submit_actions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
