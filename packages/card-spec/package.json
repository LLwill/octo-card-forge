{
  "name": "@mlt-org/octo-card-spec",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reserved workspace boundary for versioned Octo Card contracts.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": ["dist", "schemas", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. --config vitest.legacy.config.ts tests/card-spec.test.ts"
  }
}
