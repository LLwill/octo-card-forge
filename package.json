{
  "name": "@mlt-org/octo-card-cli",
  "version": "0.2.3",
  "private": false,
  "description": "Repo-free Adaptive Card authoring CLI for Octo card packages.",
  "repository": "https://github.com/LLwill/octo-card-forge",
  "type": "module",
  "packageManager": "pnpm@10.32.0",
  "bin": {
    "octo-card": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/cli.js.map",
    "web",
    "skills",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@mlt-org/octo-card-profile-octo-chat": ">=1.2.0-rc.2 <2.0.0"
  },
  "peerDependenciesMeta": {
    "@mlt-org/octo-card-profile-octo-chat": {
      "optional": true
    }
  },
  "scripts": {
    "prebuild": "node scripts/clean-build-output.mjs",
    "build": "pnpm run workspace:check && pnpm run build:packages && pnpm run build:entries",
    "build:packages": "pnpm --recursive --filter './packages/**' --filter './apps/**' --if-present run build",
    "build:entries": "node scripts/bundle-entrypoints.mjs",
    "package:deploy": "pnpm build && node scripts/package-deploy.mjs",
    "skill:pack": "node scripts/package-skill.mjs",
    "gen:catalog": "tsx scripts/generate-component-catalog.mts",
    "start": "node scripts/start-service.mjs",
    "cli": "tsx packages/cli/src/bin.ts",
    "cli:dist": "node dist/cli.js",
    "dev": "tsx packages/cli/src/bin.ts dev docs.access-request",
    "check": "tsx packages/cli/src/bin.ts check",
    "prepare:agent-validation": "node scripts/create-agent-validation-workspace.mjs",
    "smoke:repo-free-agent": "node scripts/smoke-repo-free-agent.mjs",
    "smoke:published-consumer": "node scripts/smoke-published-consumer.mjs",
    "test": "pnpm run workspace:check && pnpm run test:legacy && pnpm run test:packages",
    "test:legacy": "vitest run --config vitest.legacy.config.ts",
    "test:packages": "pnpm --recursive --filter './packages/**' --filter './apps/**' --if-present run test",
    "typecheck": "pnpm run workspace:check && pnpm run typecheck:legacy && pnpm run typecheck:packages",
    "typecheck:legacy": "tsc --noEmit",
    "typecheck:packages": "pnpm run build:packages && pnpm --recursive --filter './packages/**' --filter './apps/**' --if-present run typecheck",
    "workspace:check": "node scripts/check-workspace-dependencies.mjs"
  },
  "dependencies": {
    "adaptive-expressions": "4.23.3",
    "adaptivecards-templating": "2.3.1",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "@mlt-org/octo-card-artifact": "workspace:*",
    "@mlt-org/octo-card-catalog-snapshot": "workspace:*",
    "@mlt-org/octo-card-cli-runtime": "workspace:*",
    "@mlt-org/octo-card-core": "workspace:*",
    "@mlt-org/octo-card-preview-kit": "workspace:*",
    "@mlt-org/octo-card-spec": "workspace:*",
    "@mlt-org/octo-card-workspace": "workspace:*",
    "@types/node": "24.0.13",
    "esbuild": "0.25.12",
    "tar": "7.5.22",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
