{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@mlt-org/octo-card-artifact": ["packages/artifact/src/index.ts"],
      "@mlt-org/octo-card-core": ["packages/core/src/index.ts"],
      "@mlt-org/octo-card-spec": ["packages/card-spec/src/index.ts"],
      "@mlt-org/octo-card-workspace": ["packages/workspace/src/index.ts"],
      "@mlt-org/octo-card-preview-kit": ["packages/preview-kit/src/index.ts"],
      "@mlt-org/octo-card-cli-runtime": ["packages/cli/src/index.ts"]
    },
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["tests/**/*.ts"]
}
