# dmwork private CI image for the published Forge catalog server.
ARG NODE_IMAGE=tbj7-xtiao-tcr1.tencentcloudcr.com/xtiao-release/node:22-alpine
ARG NPM_REGISTRY=https://registry.npmmirror.com
ARG PNPM_VERSION=10.32.0

FROM ${NODE_IMAGE} AS builder

ARG NPM_REGISTRY
ARG PNPM_VERSION
RUN npm config set registry "${NPM_REGISTRY}" && npm install -g "pnpm@${PNPM_VERSION}" --force

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps ./apps
COPY packages ./packages
COPY render-profiles ./render-profiles
COPY scripts ./scripts
COPY skills ./skills
COPY web ./web
COPY tsconfig.json tsconfig.workspace-package.json workspace-packages.json ./

RUN pnpm install --frozen-lockfile --registry="${NPM_REGISTRY}"
RUN pnpm package:deploy /release \
  && mkdir /runtime \
  && tar -xzf /release/octo-card-forge-deploy-*.tgz -C /runtime

FROM ${NODE_IMAGE} AS prod-deps

ARG NPM_REGISTRY
ARG PNPM_VERSION
RUN npm config set registry "${NPM_REGISTRY}" && npm install -g "pnpm@${PNPM_VERSION}" --force

WORKDIR /app
COPY --from=builder /runtime/package.json /runtime/pnpm-lock.yaml /runtime/.npmrc ./
RUN pnpm install --frozen-lockfile --prod --registry="${NPM_REGISTRY}"

FROM ${NODE_IMAGE} AS runner

ARG GIT_COMMIT=unknown
ARG GIT_BRANCH=unknown
ARG GIT_TAG=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.title="octo-card-forge" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.ref.name="${GIT_BRANCH}" \
      org.opencontainers.image.version="${GIT_TAG}" \
      org.opencontainers.image.created="${BUILD_DATE}"

RUN addgroup -S octo \
  && adduser -S -u 10001 -G octo octo

WORKDIR /app
ENV NODE_ENV=production
ENV TZ=Asia/Shanghai

COPY --from=prod-deps --chown=octo:octo /app/node_modules ./node_modules
COPY --from=builder --chown=octo:octo /runtime ./

USER octo
EXPOSE 4318
CMD ["node", "scripts/start-service.mjs"]
